<form class="d-flex my-2" role="search">
    <input id="searchInput" class="form-control me-2" type="search" placeholder="Search for an author"
        aria-label="Search">
    <ul class="dropdown-menu" id="searchResults"></ul>
    <button id="searchButton" class="btn btn-primary disabled" type="submit">Search</button>
</form>
<p id="searchNotFound" class="d-none">There is no author with the name: <span id="searchedName"></span></p>
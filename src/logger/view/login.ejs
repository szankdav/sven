<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Discord logger statisztika - Belépés</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <div id="error">
        <h1>
            Something went wrong, please try again with the help of Sven! If the problem persists, please let Sven know!
        </h1>
    </div>
    <div id="loggedIn">
        <h1>Welcome, <span id="username"></span> to the <span id="server"></span> server's statistics page!</h1>
        <p>Take a look at how your server is being used!</p>
        <button id="enter" class="btn btn-success">Let's go</button>
    </div>
    <div id="alreadyLoggedIn">
        <h1>
            You are already logged in as: <span id="loggedInUserName"></span> from server: <span
                id="loggedInUserServer"></span>!
        </h1>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/js/login.js"></script>
    <script src="/js/index.js"></script>
</body>

</html>
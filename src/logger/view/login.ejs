<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Discord logger statisztika - Belépés</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <img class="discordLogo" src="/asserts/discord_logo.png" alt="">
    <img class="discordLogo" src="/asserts/discord_logo.png" alt="">
    <img class="discordLogo" src="/asserts/discord_logo.png" alt="">
    <img class="discordLogo" src="/asserts/discord_logo.png" alt="">
    <form id="loginForm">
        <div id="loginError" class="d-none">Username or password is incorrect!</div>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" class="form-control" id="username" aria-describedby="usernameHelp">
            <div id="usernameHelp">Please enter your username</div>
            <div id="usernameError" class="d-none">Username cannot be empty!</div>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" aria-describedby="passwordHelp">
            <div id="passwordHelp">Please enter your password</div>
            <div id="passwordError" class="d-none">Password cannot be empty!</div>
        </div>
        <div class="d-grid">
            <button id="loginButton" type="submit" class="btn btn-primary">Log in</button>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/js/login.js"></script>
</body>

</html>
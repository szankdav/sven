<div class="container mx-auto">
    <div>
        <%- include('partials/search'); %>
    </div>
    <%if(authorFound){%>
        <div class="flex flex-row">
            <div class="basis-1/4">
                <a data-testid="previousAuthorStatistics"
                    href="/statistics/author/<%if(author.id>authors[0].id){%><%=author.id-1%><%}else{%><%=authors[0].id%><%}%>"
                    class="uk-btn uk-btn-default">Previous author</a>
            </div>
            <div class="basis-1/4">
                <a data-testid="nextAuthorStatistics"
                    href="/statistics/author/<%if(author.id<authors[authors.length - 1].id){%><%=author.id+1%><%}else{%><%=authors[authors.length - 1].id%><%}%>"
                    class="uk-btn uk-btn-default">Next author</a>
            </div>
        </div>
        <div>
            <h4>Author:</h4>
            <p data-testid="id">ID: <%if(author.id){%>
                    <%= author.id %>
                        <%}else{%>
                            <%= "-" %>
                                <%}%>
            </p>
            <p data-testid="name">Name: <%= author.name %>
            </p>
            <p data-testid="created">Created: <%= author.createdAt %>
            </p>
        </div>
        <%if(author.id){%>
            <div class="flex flex-row">
                <div>
                    <a class="uk-btn uk-btn-default" data-testid="goBackToAuthor"
                        href="/messages/author/<%= author.id%>">Go
                        back to
                        author</a>
                </div>
                <div>
                    <button id="seeStatistics" data-testid="seeStatistics" class="uk-btn uk-btn-default">Show
                        statistics</button>
                </div>
            </div>
            <%}%>
                <div id="statistics" class="hidden">
                    <h4>
                        <%if(author.id){%>
                            <%= "Here you can see the usage rate of each letter out of all the letters typed by the author:"
                                %>
                                <%}else{%>
                                    <%= "-" %>
                                        <%}%>
                    </h4>
                    <% letterStatistics.forEach(stat=> { %>
                        <% Object.entries(stat).forEach(([letter, percent])=> { %>
                            <p class="mt-2">
                                <%= letter %>: <%= percent %>%
                            </p>
                            <progress class="uk-progress" value="<%= percent %>" max="100">
                                <!-- <div <% /* eslint-disable css-propertyvalueexpected */ %> class="uk-progress"
                                    style="width: <%= percent %>%"></div> -->
                            </progress>
                            <% }); %>
                                <% }); %>
                </div>
                <div>
                    <table class="uk-table uk-table-striped">
                        <thead>
                            <th>ID</th>
                            <th>Letter</th>
                            <th>Count</th>
                            <th>Created</th>
                            <th>Updated</th>
                        </thead>
                        <tbody data-testid="statisticsTable">
                            <% letterCounters.forEach(row=> { %>
                                <tr>
                                    <td>
                                        <%= row.id %>
                                    </td>
                                    <td>
                                        <%= row.letter %>
                                    </td>
                                    <td>
                                        <%= row.count %>
                                    </td>
                                    <td>
                                        <%= row.createdAt %>
                                    </td>
                                    <td>
                                        <%= row.updatedAt %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% }else{%>
                    <div>
                        <h1>No author found with this ID!</h1>
                        <a href="/home" class="uk-btn uk-btn-default">Go back to home page</a>
                    </div>
                    <%}%>
</div>
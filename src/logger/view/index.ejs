<div class="container mx-auto">
    <div class="grid grid-cols-1 px-4">
        <%if(isLoggedIn!==true ){%>
            <div>
                <h1 data-testid="welcomeH1">Welcome to our site! Please log in with
                    your Discord account to browse your server's statistics!</h1>
                <a class="uk-btn uk-btn-default"
                    href="https://discord.com/oauth2/authorize?client_id=1352273717623001209&response_type=code&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Flogin&scope=guilds+identify">Click
                    here!</a>
            </div>
            <%}else{%>
                <div>
                    <h1>Welcome to your Discord Server Monitoring site!</h1>
                </div>
                <%}%>
    </div>
</div>
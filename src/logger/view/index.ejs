</head>

<body>
    <%- include('core/navbar'); %>
        <div class="container mt-3">
            <div class="row">
                <div class="col-12">
                    <%- include('core/search'); %>
                </div>
                <div class="col-12">
                    <h1 data-testid="welcomeH1">Welcome to Discord Logger! (Watched by Watchtower!) </h1>

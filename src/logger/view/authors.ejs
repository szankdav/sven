<div class="flex-grow container mx-auto px-4 py-8">
    <% if (error==="" ) { %>
        <div class="rounded-lg shadow-lg p-6 mb-8">
            <h1 class="text-3xl font-bold mb-4">Server Authors</h1>
            <p class="text-xl md:text-2xl font-semibold mb-4">Here you can see who sent a message on your server. Click
                on an author to see
                their messages!</p>

            <div class="flex flex-col space-y-4 mb-6">
                <div class="w-full">
                    <%- include('partials/search'); %>
                </div>
                <div class="w-full">
                    <%- include('partials/pagination'); %>
                </div>
            </div>

            <div class="overflow-x-auto">
                <div class="min-w-full inline-block align-middle">
                    <div class="border rounded-lg overflow-hidden">
                        <div
                            class="grid grid-cols-3 bg-gray-700 text-gray-200 text-sm font-semibold uppercase tracking-wider py-3 px-6">
                            <div>ID</div>
                            <div>Name</div>
                            <div>Created</div>
                        </div>

                        <% authorsSlicedByTen.forEach(row=> { %>
                            <a href="/messages/author/<%= row.id %>"
                                class="grid grid-cols-3 py-4 px-6 border-t hover:bg-gray-700 transition-colors duration-200 cursor-pointer group">
                                <div class="group-hover:text-white">
                                    <%= row.id %>
                                </div>
                                <div class="font-medium group-hover:text-white">
                                    <%= row.name %>
                                </div>
                                <div class="group-hover:text-white">
                                    <%= new Date(row.createdAt).toLocaleDateString() %>
                                </div>
                            </a>
                            <% }) %>
                    </div>
                </div>
            </div>
        </div>
        <% } else { %>
            <div class="text-red-900 font-bold px-4 py-3 rounded-lg text-center mb-6">
                <p class="text-lg">
                    <%= error %>
                </p>
            </div>
            <div class="text-center">
                <a class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm
                      text-white bg-gray-900 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-200"
                    href="/home">
                    <svg class="-ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                        fill="currentColor" aria-hidden="true">
                        <path
                            d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                    </svg>
                    Go back to home page
                </a>
            </div>
            <% } %>
</div>
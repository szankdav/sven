<div class="container mx-auto">
    <%if(error==="" ){%>
        <div>
            <%- include('partials/search'); %>
        </div>
        <div>
            <%- include('partials/pagination'); %>
        </div>
        <div>
            <h4>Here you can see the who sent a message on your server. If you want to see the messages for
                an author, click on an author!</h4>
        </div>
        <div>
            <table class="uk-table uk-table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    <% authorsSlicedByTen.forEach(row=> { %>
                        <tr class="authorRow" data-id="<%= row.id %>">
                            <td uk-table-link>
                                <%= row.id %>
                            </td uk-table-link>
                            <td>
                                <%= row.name %>
                            </td>
                            <td uk-table-link>
                                <%= row.createdAt %>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>
        <%}else{%>
            <div>
                <h4>
                    <%= error %>
                </h4>
            </div>
            <div>
                <a data-testid="goBack" class="uk-btn uk-btn-default" href="/home">Go back to
                    home page</a>
            </div>
            <%}%>
</div>
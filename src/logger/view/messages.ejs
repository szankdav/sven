<div class="container mx-auto px-4 py-8">
    <% if (error==="" ) { %>
        <div class="rounded-lg shadow-lg p-6 mb-8">
            <h1 class="text-3xl font-bold mb-4">Messages</h1>
            <p class="text-xl md:text-2xl font-semibold mb-4">
                Here you can see all the messages sent on your server! If you want to see an author's messages, click on
                the author's name! To read the full message, click on it!
            </p>

            <div class="flex flex-col space-y-4 mb-6">
                <div class="w-full">
                    <%- include('partials/search'); %>
                </div>
                <div class="w-full">
                    <%- include('partials/pagination'); %>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-700">
                    <thead class="bg-gray-800">
                        <tr>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">
                                ID</th>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">
                                Author</th>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">
                                Content</th>
                            <th scope="col"
                                class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">
                                Created</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% messagesSlicedByTen.forEach(row=> { %>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <%= row.id %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold">
                                    <a href="/messages/author/<%= row.id %>" class="font-medium group-hover:text-white">
                                        <% authors.forEach(authorRow=> { %>
                                            <% if (row.authorId===authorRow.id) { %>
                                                <%= authorRow.name %>
                                                    <% } %>
                                                        <% }) %>
                                    </a>
                                </td>
                                <td data-messageid="<%= row.id %>"
                                    class="shortMessage px-6 py-4 whitespace-nowrap text-sm font-bold">
                                    <%= row.content %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <%= new Date(row.messageCreatedAt).toLocaleDateString() %>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4"
                                    class="expandedMessageDiv hidden py-4 px-6 border-t hover:bg-gray-700 hover:text-white transition-colors duration-200">
                                    <div class="flex justify-between items-center">
                                        <div class="flex-grow messageContent"></div>
                                        <div>
                                            <button
                                                class="messageCloseButton text-xl p-2 cursor-pointer hover:text-gray-400">X</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <% } else { %>
            <div class="text-red-900 font-bold px-4 py-3 rounded-lg text-center mb-6">
                <p class="text-lg">
                    <%= error %>
                </p>
            </div>
            <div class="text-center">
                <a data-testid="goBack"
                    class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm
                      text-white bg-gray-900 hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-200"
                    href="/home">
                    <svg class="-ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                        fill="currentColor" aria-hidden="true">
                        <path
                            d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
                    </svg>
                    Go back to home page
                </a>
            </div>
            <% } %>
</div>
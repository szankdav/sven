<div class="container mx-auto">
    <div>
        <%- include('partials/search'); %>
    </div>
    <%if(authorFound){%>
        <div>
            <h4>Here you can see the messages sent by the selected author.</h4>
        </div>
        <div class="flex flex-row">
            <div class="basis-1/4 md:basis-1/3">
                <a class="uk-btn uk-btn-default" data-testid="goBackToAuthors" href="/authors/1">Go back
                    to
                    authors</a>
            </div>
            <div class="basis-1/4 md:basis-1/3">
                <a data-testid="goBackToMessages" href="/messages/1" class="uk-btn uk-btn-default">Go back to
                    messages</a>
            </div>
        </div>
        <div>
            <h3>Author:</h3>
            <p data-testid="id">ID: <%= author.id %>
            </p>
            <p data-testid="name">Name: <%= author.name %>
            </p>
            <p data-testid="created">Created: <%= author.createdAt %>
            </p>
        </div>
        <div>
            <a data-testid="goToAuthorStatistics" class="uk-btn uk-btn-default"
                href="/statistics/author/<%=author.id%>">Go to
                author's statistics</a>
        </div>
        <table class="uk-table uk-table-hover uk-table-middle uk-table-responsive">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Content</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                <% messages.forEach(row=> { %>
                    <tr class="messageRow" data-id="<%= row.id %>">
                        <td>
                            <%= row.id %>
                        </td>
                        <td>
                            <%= row.content %>
                        </td>
                        <td>
                            <%= row.messageCreatedAt %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
        <% }else{%>
            <div>
                <h1>No author found with this ID!</h1>
                <a href="/home" class="uk-btn uk-btn-default">Go back to home page</a>
            </div>
            <%}%>
</div>
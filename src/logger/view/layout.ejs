<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <% if (styles) { %>
        <% styles.forEach(style=> { %>
            <link rel="stylesheet" href="<%= style %>" />
            <% }) %>
                <% } %>
                    <script src="https://cdn.jsdelivr.net/npm/franken-ui@2.0.0/dist/js/core.iife.js"
                        type="module"></script>
                    <script src="https://cdn.jsdelivr.net/npm/franken-ui@2.0.0/dist/js/icon.iife.js"
                        type="module"></script>
</head>

<body class="grid min-h-screen bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] grid-rows-[auto_1fr_auto] min-h-screen">
        <%- include('partials/navbar', { colSpanClass: 'md:col-start-1 md:row-span-full' }) %>

            <main class="col-span-1 md:col-start-2 row-start-2 overflow-y-auto">
                <%- body %>
            </main>

            <footer class="col-span-1 md:col-start-2 row-start-3 text-gray-400 text-sm text-center py-4 px-6 mt-auto">
                &copy; <%= new Date().getFullYear() %> Server Logs. All rights reserved.
            </footer>
    </div>
    <% if (scripts) { %>
        <% scripts.forEach(script=> { %>
            <script defer src="<%= script %>"></script>
            <% }) %>
                <% } %>
</body>

</html>
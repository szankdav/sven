{
  "name": "discord-chatbot",
  "version": "1.0.0",
  "description": "Chatbot for a discord server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "docker-test:build":"docker build -t sven-local -f Dockerfile.test .",
    "docker-test:start":"docker run -d --name sven-test -p 3000:3000 --env-file .env sven-local",
    "wait": "npx wait-on http://localhost:3000/",
    "prodGenerateFakeDatabaseData": "node dist/scripts/generateFakeDatabaseData.js",
    "dev": "tsx watch src/index.ts",
    "copy-css-files": "copyfiles -u 1 \"src/logger/public/**/*.css\" \"dist/\"",
    "copy-view-files": "copyfiles -u 1 \"src/logger/view/**/*\" \"dist/\"",
    "make-db-folder": "mkdirp dist/logger/database/db",
    "build": "tsup --external express && npm run copy-css-files && npm run copy-view-files && npm run make-db-folder",
    "test": "npx vitest",
    "coverage": "vitest run --coverage",
    "playwright-prod": "npm run prodGenerateFakeDatabaseData && npx playwright test",
    "playwright:docker": "npm run docker-test:build && npm run docker-test:start",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.50.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-istanbul": "^3.0.8",
    "copyfiles": "^2.4.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@types/sqlite3": "^3.1.11",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "jiti": "^2.4.2",
    "express": "^4.21.2",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.3"
  }
}

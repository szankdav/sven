{
  "name": "discord-chatbot",
  "version": "1.0.0",
  "description": "Chatbot for a discord server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "devGenerateFakeDatabaseData": "tsx src/scripts/generateFakeDatabaseData.ts",
    "devEmptyDatabase": "tsx src/scripts/emptyDatabase.ts",
    "prodGenerateFakeDatabaseData": "node dist/scripts/generateFakeDatabaseData.js",
    "prodEmptyDatabase": "node dist/scripts/emptyDatabase.js",
    "dev": "tsx watch src/index.ts",
    "copyfiles": "copyfiles -u 1 \"src/logger/view/**/*\" \"dist/\"",
    "copy-public": "copyfiles -u 1 \"public/*\" \"dist/public\"",
    "copy-db": "copyfiles -u 1 \"src/logger/database/db/\" \"dist/\"",
    "make-db-folder": "mkdirp dist/logger/database/db",
    "build": "tsup --external express && npm run copyfiles && npm run copy-public && npm run make-db-folder",
    "test": "npx vitest",
    "coverage": "vitest run --coverage",
    "playwright-dev": "npm run devGenerateFakeDatabaseData && npx playwright test && npm run devEmptyDatabase",
    "playwright-prod": "npm run prodGenerateFakeDatabaseData && npx playwright test && npm run prodEmptyDatabase",
    "start": "node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@faker-js/faker": "^9.4.0",
    "@playwright/test": "^1.50.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-istanbul": "^3.0.8",
    "copyfiles": "^2.4.1",
    "eslint": "^9.22.0",
    "express": "^4.21.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@types/sqlite3": "^3.1.11",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.3"
  }
}
